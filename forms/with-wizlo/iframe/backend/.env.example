# Backend port (default: 3022)
PORT=3022

# Wizlo API base URL (backend/API domain)
WIZLO_BASE_URL=https://api-uat.wizlo.com

# Wizlo frontend app base URL — used to build the iframe embed URL:
#   {WIZLO_APP_URL}/form-submission?token=...
# Find this in your Wizlo dashboard or ask your Wizlo account team.
WIZLO_APP_URL=https://app-uat.wizlo.com

# Your Wizlo OAuth2 M2M credentials
# Obtain from the Wizlo dashboard → Settings → API Clients
WIZLO_CLIENT_ID=your_client_id
WIZLO_CLIENT_SECRET=your_client_secret
