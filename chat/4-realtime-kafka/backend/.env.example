PORT=3063

# Kafka connection details — request these from the Wizlo team.
# This consumer is listen-only; it never publishes.
KAFKA_BOOTSTRAP_SERVERS=your-namespace.servicebus.windows.net:9093
KAFKA_TOPIC=tenant-<tenantId>-messages
KAFKA_CONSUMER_GROUP=tenant-<tenantId>-consumer

# SASL/PLAIN over TLS. Username is always the literal "$ConnectionString".
# Password is the full Azure Service Bus connection string.
KAFKA_SASL_USERNAME=$ConnectionString
KAFKA_SASL_PASSWORD=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
